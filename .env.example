# --- The browser half. VITE_ names are embedded in the bundle and are public. ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- The server half, for the functions in api/. ---
# NO VITE_ PREFIX, deliberately: Vite embeds anything prefixed VITE_ into the JavaScript
# it ships to browsers. The service role key bypasses every row level security policy in
# the database, so a VITE_ prefix on it would publish the keys to the whole desk's data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Stripe, for the functions in api/. Server only: the secret key can charge cards. ---
# STRIPE_PRICE_ID is the recurring price a checkout subscribes somebody to. It is a server
# setting on purpose — a price id taken from the request body is a request to be charged
# whatever the caller fancies, and it would be granted.
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Where Stripe returns people after checkout. Optional: without it the address is taken from
# the request, so a preview deployment returns to itself rather than bouncing somebody from
# a preview into production mid-checkout.
# SITE_URL=https://nexus-funds.vercel.app

# --- Resend, for the emails Nexus sends itself. ---
# Supabase sends "confirm your address" and "reset your password" from its own SMTP settings.
# Point those at Resend too and everything arrives from one place.
RESEND_API_KEY=re_...
NEXUS_EMAIL_FROM=Nexus RAMP <nexus@fincoursa.com>
NEXUS_EMAIL_REPLY_TO=team@fincoursa.com

# Set by Vercel for scheduled runs. Without it the reminder job is an open URL that emails
# every customer, which is a button anybody on the internet could press.
CRON_SECRET=

# --- Anthropic, for the optional column-reading help in the importer. ---
# NO VITE_ PREFIX, same reason as every other secret here: a key Vite can see is a key the
# whole desk can spend. Without it the importer works exactly as before; the tick box tells
# the trader it is unavailable rather than failing silently.
#
# What is sent: the column HEADINGS and up to three sample rows of one file, only when the
# trader ticks the box. Never the fills, never the book.
ANTHROPIC_API_KEY=sk-ant-...

# --- Cregis, for crypto payments. Server only: these can move money. ---
# NO VITE_ PREFIX, same as every other secret here.
CREGIS_PROJECT_ID=
CREGIS_API_KEY=
CREGIS_BASE_URL=https://api.cregis.com
#
# What a crypto payment buys. Both are required before checkout will run: keys without a
# price mean the server knows how to charge but not what to charge, and a default here
# would be a price nobody agreed to. One-off — crypto does not renew.
CREGIS_PRICE_AMOUNT=
CREGIS_PRICE_CURRENCY=USDT
CREGIS_GRANT_DAYS=
#
# OPTIONAL, and usually not needed. Cregis CAN restrict API calls to allowlisted IP
# addresses, and this host has none it keeps — but whether that check is enforced is a
# property of the Cregis account, and on the sibling product it was waived. Leave both
# blank unless a checkout actually fails on source IP.
#
# If one does — "E0001: The IP is not added to the whitelist <address>" — read it
# correctly: the request authenticated and reached Cregis, so the credentials are RIGHT.
# Do not rotate them. Do not allowlist the address in the message either: it is one
# invocation's egress and it rotates, so allowlisting it appears to fix the problem and
# then fails unpredictably later, which is worse than a clean failure. Raise it with
# Cregis, or point these at a relay on fixed-IP hosting. Set both or neither.
CREGIS_RELAY_URL=
CREGIS_RELAY_SECRET=
