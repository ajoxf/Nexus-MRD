# --- The browser half. VITE_ names are embedded in the bundle and are public. ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- The server half, for the functions in api/. ---
# NO VITE_ PREFIX, deliberately: Vite embeds anything prefixed VITE_ into the JavaScript
# it ships to browsers. The service role key bypasses every row level security policy in
# the database, so a VITE_ prefix on it would publish the keys to the whole desk's data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Stripe, for the functions in api/. Server only: the secret key can charge cards. ---
# STRIPE_PRICE_ID is the recurring price a checkout subscribes somebody to. It is a server
# setting on purpose — a price id taken from the request body is a request to be charged
# whatever the caller fancies, and it would be granted.
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Where Stripe returns people after checkout. Optional: without it the address is taken from
# the request, so a preview deployment returns to itself rather than bouncing somebody from
# a preview into production mid-checkout.
# SITE_URL=https://nexus-funds.vercel.app
